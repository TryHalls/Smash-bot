@@ -0,0 +1,41 @@
+package com.genymobile.scrcpy.diagnostic;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+public class Task007TimingStateTest {
+
+    @Test
+    public void actionDownCreatesOneRecordAndMoveUpCannotReplaceIt() {
+        Task007TimingState state = new Task007TimingState();
+        state.beginActionDown(540, 1200, 100L);
+        state.completeActionDown(140L, true);
+
+        Task007TimingState.Snapshot first = state.snapshot(200L, true);
+        Assert.assertEquals(1L, first.actionSequence);
+        Assert.assertEquals(540, first.actionX);
+        Assert.assertEquals(1200, first.actionY);
+        Assert.assertEquals(100L, first.d0);
+        Assert.assertEquals(140L, first.d1);
+        Assert.assertTrue(first.injectSuccess);
+
+        // The controller calls beginActionDown() only for ACTION_DOWN.  A
+        // MOVE/UP therefore has no state API call that could replace this
+        // record; the next ACTION_DOWN is the only permitted increment.
+        Task007TimingState.Snapshot unchanged = state.snapshot(210L, true);
+        Assert.assertEquals(first.actionSequence, unchanged.actionSequence);
+        Assert.assertEquals(first.actionX, unchanged.actionX);
+        Assert.assertEquals(first.actionY, unchanged.actionY);
+        Assert.assertEquals(first.d0, unchanged.d0);
+        Assert.assertEquals(first.d1, unchanged.d1);
+
+        state.beginActionDown(720, 1000, 300L);
+        state.completeActionDown(340L, true);
+        Task007TimingState.Snapshot second = state.snapshot(400L, true);
+        Assert.assertEquals(2L, second.actionSequence);
+        Assert.assertEquals(720, second.actionX);
+        Assert.assertEquals(1000, second.actionY);
+        Assert.assertEquals(300L, second.d0);
+        Assert.assertEquals(340L, second.d1);
+    }
+}
