@@ -0,0 +1,55 @@
+package com.genymobile.scrcpy.diagnostic;
+
+import com.genymobile.scrcpy.util.IO;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Fixed v1 sidecar written only by the explicitly selected Task 007 server. */
+public final class Task007Telemetry {
+
+    public static final int SIZE = 56;
+    private static final int VERSION = 1;
+    private static final short ACTION_TIMING = 1;
+    private static final short INJECTION_RETURNED = 1 << 1;
+    private static final short INJECT_SUCCESS = 1 << 2;
+    private static final short D2_VALID = 1 << 3;
+
+    private Task007Telemetry() {
+        // utility class
+    }
+
+    public static void write(FileDescriptor fd, Task007TimingState.Snapshot snapshot, boolean config) throws IOException {
+        short flags = 0;
+        if (snapshot.actionSequence != 0) {
+            flags |= ACTION_TIMING;
+            if (snapshot.d1 != 0) {
+                flags |= INJECTION_RETURNED;
+                if (snapshot.injectSuccess) {
+                    flags |= INJECT_SUCCESS;
+                }
+            }
+        }
+        long d2 = 0;
+        if (!config) {
+            flags |= D2_VALID;
+            d2 = snapshot.d2;
+        }
+
+        ByteBuffer buffer = ByteBuffer.allocate(SIZE).order(ByteOrder.BIG_ENDIAN);
+        buffer.put((byte) 'T').put((byte) '7').put((byte) 'T').put((byte) 'M');
+        buffer.putShort((short) VERSION);
+        buffer.putShort(flags);
+        buffer.putLong(snapshot.actionSequence);
+        buffer.putInt(snapshot.actionX);
+        buffer.putInt(snapshot.actionY);
+        buffer.putLong(snapshot.d0);
+        buffer.putLong(snapshot.d1);
+        buffer.putLong(d2);
+        buffer.putLong(0L); // reserved
+        buffer.flip();
+        IO.writeFully(fd, buffer);
+    }
+}
