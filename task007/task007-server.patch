+package com.genymobile.scrcpy.diagnostic;
+
+/** Thread-safe latest ACTION_DOWN timing state for the Task 007 diagnostic server. */
+public final class Task007TimingState {
+
+    private long actionSequence;
+    private int actionX;
+    private int actionY;
+    private long d0;
+    private long d1;
+    private boolean injectSuccess;
+
+    public synchronized void beginActionDown(int x, int y, long timestampNanos) {
+        ++actionSequence;
+        actionX = x;
+        actionY = y;
+        d0 = timestampNanos;
+        d1 = 0;
+        injectSuccess = false;
+    }
+
+    public synchronized void completeActionDown(long timestampNanos, boolean success) {
+        d1 = timestampNanos;
+        injectSuccess = success;
+    }
+
+    public synchronized Snapshot snapshot(long d2, boolean d2Valid) {
+        return new Snapshot(actionSequence, actionX, actionY, d0, d1, injectSuccess, d2, d2Valid);
+    }
+
+    public static final class Snapshot {
+        public final long actionSequence;
+        public final int actionX;
+        public final int actionY;
+        public final long d0;
+        public final long d1;
+        public final boolean injectSuccess;
+        public final long d2;
+        public final boolean d2Valid;
+
+        private Snapshot(long actionSequence, int actionX, int actionY, long d0, long d1,
+                boolean injectSuccess, long d2, boolean d2Valid) {
+            this.actionSequence = actionSequence;
+            this.actionX = actionX;
+            this.actionY = actionY;
+            this.d0 = d0;
+            this.d1 = d1;
+            this.injectSuccess = injectSuccess;
+            this.d2 = d2;
+            this.d2Valid = d2Valid;
+        }
+    }
+}
